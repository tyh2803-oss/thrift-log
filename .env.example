# Supabase project settings. Public URL/key identify the project; RLS protects its data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Restrict sign-in to your account. Disable public signups in Supabase as well.
OWNER_EMAIL=
# Marketplace API clients are not enabled until official docs and permissions are verified.
