# Supabase project settings. Public URL/key identify the project; RLS protects its data.
NEXT_PUBLIC_SUPABASE_URL=
# Active publishable key (sb_publishable_...) or legacy anon key; keep this existing variable name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: existing secret (sb_secret_...) or legacy service_role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Owner administrator identity. Other users require explicit database beta authorization.
# Keep public signups disabled in Supabase.
OWNER_EMAIL=
# Canonical HTTPS app origin for invite links, e.g. https://thrift-log.example.com (no path).
# Configure the Supabase invitation email template as documented in docs/BETA_ACCESS.md.
BETA_SITE_URL=
# Optional registration; disabled by default. Requires migration 202611110002.
# preauthorized = no email proof (explicit beta opt-in); email = confirmation required.
# Neither mode enables public Supabase signup. See docs/BETA_REGISTRATION.md before enabling.
BETA_REGISTRATION_MODE=disabled
# Optional Whatnot integration: apply 202611120001 only with approval.
# Optional stable encryption key (64 hexadecimal characters). If omitted, a domain-separated
# key derives from SUPABASE_SERVICE_ROLE_KEY; rotating that server key requires reconnecting tokens.
WHATNOT_TOKEN_ENCRYPTION_KEY=
# Required only for Vercel background cron (random secret of at least 32 characters).
# Each user supplies their own PAT securely in Settings, never in these variables.
CRON_SECRET=

# Optional screenshot assistant (server only; never use NEXT_PUBLIC_).
OPENAI_API_KEY=
# Optional overrides. Sol is the default for business chat and file/image extraction.
# The server API key remains OPENAI_API_KEY; never use a NEXT_PUBLIC_ prefix for it.
OPENAI_ASSISTANT_MODEL=gpt-6.1-sol
OPENAI_ASSISTANT_REASONING_EFFORT=medium
# Leave blank to inherit OPENAI_ASSISTANT_MODEL. No automatic model fallback.
OPENAI_SCREENSHOT_MODEL=
# 1–10; default 10 images per batch. No automatic model fallback.
ASSISTANT_BATCH_LIMIT=10
