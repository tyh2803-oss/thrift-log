{
  "name": "thrift-log",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.mjs *.json",
    "supabase:verify": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/verify-supabase.mjs",
    "supabase:test-hosted": "node --env-file=.env.local --experimental-strip-types scripts/verify-hosted.mjs",
    "supabase:test-browser": "node --env-file=.env.local --experimental-strip-types scripts/verify-browser-auth.mjs",
    "https:setup": "node scripts/setup-local-https.mjs",
    "dev:https": "node scripts/dev-https.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "16.4.5",
    "papaparse": "latest",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "latest",
    "server-only": "latest",
    "sharp": "0.35.5",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/papaparse": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.9.0"
}
